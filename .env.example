# Server
PORT=3000

# Database MySQL Aiven
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=nyucik_db
DB_PORT=3306
DB_SSL=false
DB_POOL_LIMIT=10

# JWT (1 token, expired 1d)
JWT_SECRET=nyucik_super_secret_key
JWT_EXPIRES_IN=1d

# Cloudinary (folder: nyucik/profiles, nyucik/bookings/before, nyucik/bookings/arrived, nyucik/products, nyucik/announcements, nyucik/machines)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Gmail App Password)
EMAIL_USER=
EMAIL_PASS=

# Testing Postman/Flutter: set true biar OTP muncul di response (JANGAN true di production)
SEND_OTP_IN_RESPONSE=false

# KiPay QRIS gateway (https://api.kipay.biz.id)
KIPAY_BASE_URL=https://api.kipay.biz.id
# API key project. Untuk pembayaran nyata, gunakan API key project production.
KIPAY_API_KEY=
# Opsional: link halaman pembayaran publik project.
KIPAY_PAYMENT_URL=


