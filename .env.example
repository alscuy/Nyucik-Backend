# Server
PORT=3000

# Database MySQL Aiven
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=nyucik_db
DB_PORT=3306
DB_SSL=false
DB_POOL_LIMIT=10

# JWT (1 token, expired 1d)
JWT_SECRET=nyucik_super_secret_key
JWT_EXPIRES_IN=1d

# Cloudinary (folder: nyucik/profiles, nyucik/bookings/before, nyucik/bookings/arrived, nyucik/products, nyucik/announcements, nyucik/machines)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Gmail App Password)
EMAIL_USER=
EMAIL_PASS=

# Testing Postman/Flutter: set true biar OTP muncul di response (JANGAN true di production)
SEND_OTP_IN_RESPONSE=false

# QRIS Dinamis manual: payload QRIS STATIS merchant (scan gambar QRIS pakai QR reader)
# Dipakai kalau kredensial DANA MPM kosong
QRIS_STATIC_PAYLOAD=

# DANA MPM (QRIS partner) — top up beneran
# Daftar partner: https://developer.dana.id  (sandbox / production)
DANA_ENV=sandbox
DANA_BASE_URL=
DANA_CLIENT_ID=
DANA_PARTNER_ID=
DANA_CHANNEL_ID=95221
DANA_MERCHANT_ID=
DANA_STORE_ID=
DANA_ORIGIN=https://nyucik-backend.vercel.app
# Private key RSA (PEM). Boleh satu baris dengan \n
DANA_PRIVATE_KEY=


