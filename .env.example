# Server
PORT=3000

# Database MySQL Aiven
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=nyucik_db
DB_PORT=3306

# JWT (1 token, expired 1d)
JWT_SECRET=nyucik_super_secret_key
JWT_EXPIRES_IN=1d

# Cloudinary (folder otomatis: nyucik/profiles, nyucik/bookings/before, nyucik/bookings/arrived, nyucik/products, nyucik/announcements, nyucik/machines)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Gmail App Password)
EMAIL_USER=
EMAIL_PASS=

# Untuk testing di Swagger: set true biar OTP muncul di response (JANGAN true di production)
SEND_OTP_IN_RESPONSE=false

# DANA QRIS (Acquirer MPM). Kosongkan dulu jika belum punya kredensial -> mode sandbox
DANA_MERCHANT_ID=
DANA_TERMINAL_ID=
DANA_CLIENT_ID=
DANA_CLIENT_SECRET=
DANA_PRIVATE_KEY=
DANA_PUBLIC_KEY=
DANA_WEBHOOK_SECRET=webhook_secret_sandbox
DANA_API_URL=
FRONTEND_URL=http://localhost:5173
